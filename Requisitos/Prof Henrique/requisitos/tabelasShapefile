export class AreaQueimada {
  gid: number;
  dn: number;
  data: string;

  constructor(gid: number, dn: number, data: string) {
    this.gid = gid;
    this.dn = dn;
    this.data = data;
  }
}

/////////////////////////////////////////////////////

export class Bioma {
  gid: number;
  bioma: string;
  cd_bioma: number;

  constructor(gid: number, bioma: string, cd_bioma: number) {
    this.gid = gid;
    this.bioma = bioma;
    this.cd_bioma = cd_bioma;
  }
}

