export class FocosMensal {
  id: string;              // UUID
  lat: number;             // Latitude
  lon: number;             // Longitude
  data_hora_gmt: Date;     // Data e hora em GMT

  constructor(
    id: string,
    lat: number,
    lon: number,
    data_hora_gmt: Date,
  ) {
    this.id = id;
    this.lat = lat;
    this.lon = lon;
    this.data_hora_gmt = data_hora_gmt;
  }
}
